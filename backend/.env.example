# Tavora backend
APP_ENV=development

# Keep the MongoDB variables that your existing app/database/mongodb.py expects.
# Typical Tavora setup:
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/
DATABASE_NAME=tavora

# Generate a long random value before production.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated frontend origins. Add Render/production URLs here.
CORS_ORIGINS=https://your-frontend.example.com

# Subscription prices in euro cents. These defaults are €9.99 / €29.99 / €49.99.
TAVORA_STARTER_PRICE_MINOR=999
TAVORA_STANDARD_PRICE_MINOR=2999
TAVORA_PRO_PRICE_MINOR=4999

# Paddle Billing
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_PRICE_ID_STARTER=
PADDLE_PRICE_ID_STANDARD=
PADDLE_PRICE_ID_PRO=
PADDLE_WEBHOOK_SECRET=
PADDLE_WEBHOOK_TOLERANCE_SECONDS=300

# Optional approved/default-payment-link page used by Paddle checkout.
# Example: https://app.yourdomain.com/#/payment-plan
PADDLE_CHECKOUT_BASE_URL=
